# ============================================================================
# AI Resume Screening & Candidate Intelligence Platform - Environment Variables
# ============================================================================

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://resume_user:resume_pass@localhost:5432/resume_screening
# Fallback SQLite URL if PostgreSQL is offline
FALLBACK_DATABASE_URL=sqlite:////home/user/backend/data/resume_screening.db

# JWT & Security Configuration
JWT_SECRET_KEY=tp_enterprise_ai_resume_screening_secret_2026_x99k2m
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,txt
UPLOAD_DIR=/home/user/backend/uploads

# NLP / ML Pipeline Settings
SPACY_MODEL=en_core_web_md
FAIRNESS_GUARD_ENABLED=true

# Server & CORS Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=*
